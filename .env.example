# Required for live VLM Storyboard Extraction & Multimodal RAG Synthesis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VLM_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Optional: Leave empty to use the built-in Local JSON + NumPy Cosine Vector Index
PINECONE_API_KEY=
PINECONE_INDEX_NAME=sieverag-episodes
PINECONE_NAMESPACE=default

# vlm-sieve v0.3.0 Target Profile (gemini | qwen-vl | local-7b | gpt-4o)
DEFAULT_TARGET_VLM=qwen-vl
